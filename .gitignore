node_modules/
.DS_Store
*.log
.env*
dist/
coverage/

# llm-model-listing targets one vendor's endpoint and is deliberately local:
# `private: true` keeps it off npm, root `files` keeps it out of the published
# tarball, and githooks/dsh-pouch/pre-push refuses any push whose tree carries
# it. Staying untracked is the layer that keeps it out of history to begin with.
/packages/dsh-plugin-llm-model-listing/

# core-memory mirrors one specific workspace's memory/core layout — it is the
# DSH twin of that workspace's shell-side inject_core.sh hook, useless anywhere
# else. Same three-layer local-only treatment as llm-model-listing.
/packages/dsh-plugin-core-memory/

# Local-only READMEs: the tracked pair plus the local-only plugin. The tracked
# pair is what GitHub and npm render, so it must never name a package the
# reader cannot install. `LOCAL-README*` and not `README.local*` because npm
# force-includes any root README* file — .npmignore and `files` negations both
# lose to it (verified with `npm pack --dry-run`). The two copies are kept in
# sync by hand: when the tracked pair changes, copy it over and re-apply the
# local-only sections.
/LOCAL-README.md
/LOCAL-README.zh-CN.md
